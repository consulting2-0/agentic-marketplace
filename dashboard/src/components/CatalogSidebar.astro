---
import { TYPE_CONFIG, ICONS } from '../lib/icons';
import { fetchComponents } from '../lib/data';

interface Props { activeType: string }
const { activeType } = Astro.props;

const counts: Record<string, number> = {};
try {
  const data = await fetchComponents();
  for (const t of Object.keys(TYPE_CONFIG)) {
    counts[t] = ((data as any)[t] as any[])?.length ?? 0;
  }
} catch {}
---

<aside class="hidden md:block w-56 shrink-0">
  <div class="sticky top-[72px] space-y-1">
    <!-- Workspace -->
    <a
      href="/workspace"
      class="flex items-center gap-2.5 px-3 h-10 rounded-lg text-[13.5px] font-medium text-text-primary hover:bg-surface-2 transition-colors"
    >
      <svg class="w-4 h-4 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
      </svg>
      My Workspace
    </a>

    <div class="px-3 pt-4 pb-1.5">
      <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-text-tertiary" style="font-family: var(--font-ui);">Catalog</span>
    </div>

    {Object.entries(TYPE_CONFIG).map(([type, config]) => {
      const active = activeType === type;
      return (
        <a
          href={`/${type}`}
          class:list={[
            'group flex items-center gap-2.5 px-3 h-9 rounded-lg text-[13.5px] transition-colors',
            active ? 'bg-primary-50 text-primary-700 font-medium' : 'text-text-secondary hover:bg-surface-2 hover:text-text-primary',
          ]}
        >
          <span
            class="w-4 h-4 shrink-0 [&>svg]:w-4 [&>svg]:h-4"
            style={active ? `color:${config.color}` : ''}
            set:html={ICONS[type]}
          />
          <span class="flex-1 truncate">{config.label}</span>
          <span class:list={['text-[11px] tabular-nums', active ? 'text-primary-600' : 'text-text-tertiary']}>{counts[type] ?? ''}</span>
        </a>
      );
    })}
  </div>
</aside>
