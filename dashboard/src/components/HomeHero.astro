---
import { TYPE_CONFIG, ICONS } from '../lib/icons';

// Real component artifacts orbiting "your Claude" — grounds the 3D scene in the product.
const chips = [
  { name: 'frontend-developer', type: 'agents',   x: 15, y: 22, z: -150, r: -7, d: 0.05 },
  { name: 'security-auditor',   type: 'agents',   x: 80, y: 17, z:  -70, r:  6, d: 0.18 },
  { name: '/setup-testing',     type: 'commands', x: 14, y: 56, z:   70, r: -4, d: 0.10 },
  { name: 'Context7',           type: 'mcps',     x: 85, y: 50, z:   30, r:  7, d: 0.24 },
  { name: 'prevent-force-push', type: 'hooks',    x: 20, y: 83, z:  -30, r:  5, d: 0.30 },
  { name: 'pdf',                type: 'skills',   x: 80, y: 84, z:  100, r: -6, d: 0.14 },
];
---

<section class="hero3d">
  <div class="hero-glow" aria-hidden="true"></div>

  <!-- 3D component constellation (desktop only) -->
  <div id="heroScene" class="hero-scene" aria-hidden="true">
    <div class="hero-stage">
      {chips.map((c) => {
        const cfg = TYPE_CONFIG[c.type];
        return (
          <div class="chip" style={`--x:${c.x}%; --y:${c.y}%; --z:${c.z}px; --r:${c.r}deg; --d:${c.d}s;`}>
            <div class="chip-card">
              <span class="chip-ico" style={`background:${cfg.color}22; color:${cfg.color};`} set:html={ICONS[c.type]} />
              <span class="chip-name">{c.name}</span>
              <span class="chip-type">{cfg.label}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Hero content -->
  <div class="hero-content">
    <span class="hero-eyebrow">The agentic marketplace for Claude Code</span>
    <h1 class="hero-title">
      <span class="ht-line">Supercharge your</span>
      <span class="claude-word">Claude</span>
    </h1>
    <p class="hero-sub">
      Browse and install the best agents, skills, commands, hooks and MCP integrations for Claude Code — ready to run in seconds.
    </p>
    <button id="heroSearchTrigger" class="hero-search">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span>Search the catalog…</span>
      <kbd>⌘K</kbd>
    </button>
  </div>
</section>

<style>
  .hero3d {
    position: relative;
    overflow: hidden;
    min-height: 86vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem 2rem;
  }

  /* soft brand depth glow */
  .hero-glow {
    position: absolute;
    inset: -10% -10% 0 -10%;
    pointer-events: none;
    background:
      radial-gradient(40% 34% at 50% 48%, rgba(217, 119, 87, 0.13), transparent 68%),
      radial-gradient(44% 40% at 28% 26%, rgba(0, 87, 255, 0.09), transparent 70%),
      radial-gradient(40% 38% at 74% 76%, rgba(0, 229, 153, 0.09), transparent 72%);
    filter: saturate(1.05);
  }

  /* 3D scene */
  .hero-scene {
    position: absolute;
    inset: 0;
    perspective: 1300px;
    pointer-events: none;
    display: none;
  }
  @media (min-width: 1080px) {
    .hero-scene { display: block; }
  }
  .hero-stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%) translateZ(var(--z)) rotate(var(--r));
    transform-style: preserve-3d;
    opacity: 0;
    animation: chipIn 0.7s ease-out forwards;
    animation-delay: var(--d);
  }
  .chip-card {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 13px 8px 9px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(22, 21, 15, 0.07);
    box-shadow:
      0 22px 45px -18px rgba(11, 18, 40, 0.38),
      0 3px 8px rgba(11, 18, 40, 0.06);
    white-space: nowrap;
    animation: floaty 9s ease-in-out infinite;
    animation-delay: var(--d);
  }
  .chip-ico {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .chip-ico :global(svg) { width: 15px; height: 15px; }
  .chip-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: #16150F;
    font-weight: 500;
  }
  .chip-type {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8A867A;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }

  /* content */
  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #0045cc;
    background: rgba(0, 87, 255, 0.07);
    border: 1px solid rgba(0, 87, 255, 0.14);
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 22px;
    animation: rise 0.7s ease-out both;
  }
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    animation: rise 0.8s ease-out 0.06s both;
  }
  .ht-line {
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-weight: 600;
    font-size: clamp(22px, 3vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: #1A1813;
    margin-bottom: 4px;
  }
  /* Claude-flavoured blocky pixel wordmark */
  .claude-word {
    font-family: 'Pixelify Sans', monospace;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(60px, 11vw, 132px);
    line-height: 0.92;
    letter-spacing: 0.015em;
    color: #D97757;
    -webkit-text-stroke: 5px #FBEFE8;
    paint-order: stroke fill;
    text-shadow:
      2px 2px 0 #cc6a48,
      4px 4px 0 #bf5e3e,
      6px 6px 0 #b15333,
      8px 8px 0 #a3492b,
      11px 11px 22px rgba(120, 52, 30, 0.32);
  }
  .hero-sub {
    margin: 18px auto 0;
    max-width: 540px;
    font-size: 15.5px;
    line-height: 1.6;
    color: #5C5A50;
    animation: rise 0.8s ease-out 0.14s both;
  }
  .hero-search {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    height: 46px;
    padding: 0 8px 0 18px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--color-border, #E9E6DF);
    color: #8A867A;
    font-size: 14px;
    box-shadow: 0 10px 30px -12px rgba(11, 18, 40, 0.22);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    animation: rise 0.8s ease-out 0.2s both;
  }
  .hero-search:hover {
    transform: translateY(-2px);
    border-color: #D8D3C7;
    box-shadow: 0 16px 38px -14px rgba(11, 18, 40, 0.3);
  }
  .hero-search kbd {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 8px;
    background: #F4F2EC;
    color: #5C5A50;
  }

  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }
  @keyframes chipIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip-card { animation: none; }
    .chip { animation: none; opacity: 1; }
    .hero-eyebrow, .hero-title, .hero-sub, .hero-search { animation: none; }
    .hero-stage { transition: none; }
  }
</style>

<script>
  // Cursor parallax — rotate the 3D stage; per-chip depth (translateZ) gives true parallax.
  const scene = document.getElementById('heroScene');
  const section = scene?.closest('.hero3d') as HTMLElement | null;
  const stage = scene?.querySelector('.hero-stage') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section && stage && !reduce.matches) {
    let raf = 0;
    section.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const r = section.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        stage.style.setProperty('--ry', `${px * 11}deg`);
        stage.style.setProperty('--rx', `${-py * 11}deg`);
        raf = 0;
      });
    });
    section.addEventListener('pointerleave', () => {
      stage.style.setProperty('--ry', '0deg');
      stage.style.setProperty('--rx', '0deg');
    });
  }

  // Hero search opens the same Cmd+K modal as the header trigger.
  document.getElementById('heroSearchTrigger')?.addEventListener('click', () => {
    document.getElementById('searchTrigger')?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
  });
</script>
