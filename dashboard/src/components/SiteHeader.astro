---
import AuthButton from './AuthButton';
import { NAV_LINKS } from '../lib/constants';
---

<header class="sticky top-0 z-30 bg-surface-0/85 backdrop-blur-md border-b border-border">
  <div class="flex items-center gap-4 px-5 md:px-8 h-14 max-w-[1180px] mx-auto">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <svg width="28" height="28" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
        <rect width="200" height="200" rx="44" fill="#071535"/>
        <g transform="translate(16, 16) scale(1.9)">
          <path d="M44 4L80 24V64L44 84L8 64V24L44 4Z" fill="#071535" stroke="#0057FF" stroke-width="1.5"/>
          <line x1="44" y1="24" x2="26" y2="46" stroke="#0057FF" stroke-opacity="0.5" stroke-width="1.3"/>
          <line x1="44" y1="24" x2="62" y2="46" stroke="#0057FF" stroke-opacity="0.5" stroke-width="1.3"/>
          <line x1="26" y1="46" x2="44" y2="64" stroke="#00E599" stroke-opacity="0.65" stroke-width="1.3"/>
          <line x1="62" y1="46" x2="44" y2="64" stroke="#00E599" stroke-opacity="0.65" stroke-width="1.3"/>
          <line x1="26" y1="46" x2="62" y2="46" stroke="#7B4FFF" stroke-opacity="0.35" stroke-width="1"/>
          <circle cx="44" cy="24" r="5.5" fill="#0057FF"/>
          <circle cx="44" cy="24" r="9" fill="#0057FF" fill-opacity="0.15"/>
          <circle cx="26" cy="46" r="4.5" fill="#3D80FF"/>
          <circle cx="62" cy="46" r="4.5" fill="#3D80FF"/>
          <circle cx="44" cy="64" r="5.5" fill="#00E599"/>
          <circle cx="44" cy="64" r="9" fill="#00E599" fill-opacity="0.15"/>
          <circle cx="20" cy="32" r="2.8" fill="#7B4FFF" fill-opacity="0.8"/>
          <circle cx="68" cy="32" r="2.8" fill="#7B4FFF" fill-opacity="0.8"/>
          <circle cx="20" cy="58" r="2.2" fill="#FF8C00" fill-opacity="0.7"/>
          <circle cx="68" cy="58" r="2.2" fill="#FF8C00" fill-opacity="0.7"/>
        </g>
      </svg>
      <span class="text-[17px] font-semibold tracking-tight" style="font-family: var(--font-ui);">
        consulting<span class="text-primary-500">2.0</span>
      </span>
    </a>

    <!-- Prominent search trigger -->
    <button
      id="searchTrigger"
      class="group flex items-center gap-2.5 px-4 h-9 flex-1 max-w-md mx-auto bg-surface-1 border border-border rounded-full text-[13px] text-text-tertiary hover:border-border-hover transition-colors"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span>Search agents, skills, commands…</span>
      <kbd class="hidden sm:inline-flex ml-auto items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono border border-border rounded text-text-tertiary">⌘K</kbd>
    </button>

    <!-- Right: trending link, workspace, auth -->
    <nav class="flex items-center gap-2.5 shrink-0">
      <a href={NAV_LINKS.trending} class="hidden sm:inline text-[13px] text-text-secondary hover:text-text-primary px-1">Trending</a>
      <a
        href="/workspace"
        class="relative inline-flex items-center gap-1.5 px-3 h-9 rounded-full border border-border hover:border-border-hover text-[13px] font-medium text-text-primary transition-colors"
        aria-label="My workspace"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span class="hidden sm:inline">Workspace</span>
        <span id="workspaceCount" class="hidden min-w-[18px] h-[18px] px-1 rounded-full bg-primary-500 text-white text-[10px] font-semibold items-center justify-center"></span>
      </a>
      <AuthButton client:load />
    </nav>
  </div>
</header>

<script>
  function workspaceCount(): number {
    try {
      const c = JSON.parse(localStorage.getItem('claudeCodeCart') || '{}');
      return Object.values(c).reduce((s: number, a) => s + (Array.isArray(a) ? a.length : 0), 0);
    } catch {
      return 0;
    }
  }
  function renderWorkspaceCount() {
    const el = document.getElementById('workspaceCount');
    if (!el) return;
    const n = workspaceCount();
    if (n > 0) {
      el.textContent = String(n);
      el.classList.remove('hidden');
      el.classList.add('inline-flex');
    } else {
      el.classList.add('hidden');
      el.classList.remove('inline-flex');
    }
  }
  window.addEventListener('cart-updated', renderWorkspaceCount);
  window.addEventListener('storage', renderWorkspaceCount);
  renderWorkspaceCount();
</script>
